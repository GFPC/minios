/*
 * minios /init  —  visual progress + USB ACM + DRM display
 *
 * Color code (top 1/4 of screen):
 *   DARK BLUE  = init started
 *   PURPLE     = mounts OK
 *   YELLOW     = USB starting
 *   GREEN      = USB BOUND  ← success
 *   RED        = USB failed
 */
